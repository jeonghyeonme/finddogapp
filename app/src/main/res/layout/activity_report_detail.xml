<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 제보 이미지 -->
    <ImageView
        android:id="@+id/imageViewDetailImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="제보 이미지" />

    <!-- 작성자 표시 -->
    <TextView
        android:id="@+id/textViewReporter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="작성자: 익명0000"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- 제보 설명 -->
    <TextView
        android:id="@+id/textViewDetailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:textSize="16sp"
        android:text="설명 내용"
        android:textColor="#000000" />

    <!-- 댓글 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewComments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <!-- 댓글 작성 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editTextComment"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="댓글을 입력하세요"
            android:inputType="text"
            android:paddingHorizontal="8dp"
            android:background="@android:drawable/edit_text" />

        <Button
            android:id="@+id/buttonSubmitComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="작성" />
    </LinearLayout>
</LinearLayout>